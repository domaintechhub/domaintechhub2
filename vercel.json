{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install --legacy-peer-deps",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "domaintechhubs.com"
        }
      ],
      "destination": "https://www.domaintechhubs.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "domaintechhub.com"
        }
      ],
      "destination": "https://www.domaintechhubs.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.domaintechhub.com"
        }
      ],
      "destination": "https://www.domaintechhubs.com/$1",
      "permanent": true
    },
    {
      "source": "/services/ecommerce-mpesa",
      "destination": "/services/ecommerce-development",
      "permanent": true
    },
    {
      "source": "/services/ecommerce",
      "destination": "/services/ecommerce-development",
      "permanent": true
    },
    {
      "source": "/services/seo-optimization",
      "destination": "/services/seo-services",
      "permanent": true
    },
    {
      "source": "/services/seo",
      "destination": "/services/seo-services",
      "permanent": true
    },
    {
      "source": "/services/custom-software",
      "destination": "/services/custom-crm-development",
      "permanent": true
    },
    {
      "source": "/services/crm",
      "destination": "/services/custom-crm-development",
      "permanent": true
    },
    {
      "source": "/services/branding-design",
      "destination": "/services/graphic-design-branding",
      "permanent": true
    },
    {
      "source": "/services/branding",
      "destination": "/services/graphic-design-branding",
      "permanent": true
    },
    {
      "source": "/services/sem-ppc",
      "destination": "/services/ppc-management",
      "permanent": true
    },
    {
      "source": "/services/sem",
      "destination": "/services/ppc-management",
      "permanent": true
    },
    {
      "source": "/services/ppc",
      "destination": "/services/ppc-management",
      "permanent": true
    },
    {
      "source": "/services/web-hosting",
      "destination": "/services/website-maintenance",
      "permanent": true
    },
    {
      "source": "/services/cloud-hosting",
      "destination": "/services/website-maintenance",
      "permanent": true
    },
    {
      "source": "/services/hosting",
      "destination": "/services/website-maintenance",
      "permanent": true
    },
    {
      "source": "/blog/:slug",
      "destination": "/insights/:slug",
      "permanent": true
    },
    {
      "source": "/calculator",
      "destination": "/tools/calculator",
      "permanent": true
    },
    {
      "source": "/audit",
      "destination": "/tools/audit",
      "permanent": true
    },
    {
      "source": "/domains",
      "destination": "/tools/domains",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=3600"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=3600"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
